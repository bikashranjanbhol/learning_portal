# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, OG images, OAuth
# redirects and sitemap generation. On Vercel set this to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser and
# never prefix with NEXT_PUBLIC_. Used by scripts/verify-rls.ts and, later,
# by the Stripe webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Not used in Sprint 0. Listed so the full surface is visible up front.
# ---------------------------------------------------------------------------

# --- Stripe (Sprint 3) ------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PostHog (Sprint 2+) ----------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- AI tutor (Sprint 5) ----------------------------------------------------
# ANTHROPIC_API_KEY=
# AI_MONTHLY_SPEND_CEILING_USD=50
